<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="10.0"
  ExtensionBundleId="com.counterpoint.switcher"
  ExtensionBundleVersion="0.1.0"
  ExtensionBundleName="Counterpoint Switcher">
  <ExtensionList>
    <Extension Id="com.counterpoint.switcher.panel" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.counterpoint.switcher.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Counterpoint Switcher</Menu>
          <Geometry>
            <Size><Height>700</Height><Width>520</Width></Size>
            <MinSize><Height>360</Height><Width>380</Width></MinSize>
            <MaxSize><Height>3000</Height><Width>2000</Width></MaxSize>
          </Geometry>
          <Icons/>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
